# Public API the marketing form will call. Never point this at admin hosts.
# Stage: https://api-stage.tablio.hr
# Production: https://api.tablio.hr
NEXT_PUBLIC_API_URL=https://api-stage.tablio.hr

# Marketing origin baked into the image (canonical, robots, OG).
# Stage: https://stage.tablio.hr  → noindex, nofollow
# Production: https://tablio.hr   → index + canonical
NEXT_PUBLIC_SITE_URL=https://stage.tablio.hr

# Host this instance serves. Traefik Host() + app allowlist.
# Stage: stage.tablio.hr
# Production: tablio.hr
# Never set this to www.tablio.hr — Cloudflare 301s www → apex.
TABLIO_WEB_HOST=stage.tablio.hr
